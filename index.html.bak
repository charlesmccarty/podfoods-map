        indexById[slide.id] = i;
        var dot = document.createElement("button");
        dot.type = "button";
        dot.className = "progress-dot";
        dot.setAttribute("aria-label", "Go to slide " + (i + 1));
        dot.addEventListener("click", function () { goTo(i); });
        progress.appendChild(dot);
      });

      var dots = Array.prototype.slice.call(progress.querySelectorAll(".progress-dot"));

      function fitSlide(slide) {
        var scaleEl = slide.querySelector(".slide-scale");
        var inner = slide.querySelector(".slide-inner");
        if (!scaleEl || !inner) return;
        var centered = slide.id === "hero";
        var base = centered ? "translate(-50%, -50%)" : "translateX(-50%)";
        scaleEl.style.transform = base;
        var availableH = Math.max(0, inner.clientHeight);
        var availableW = Math.max(0, inner.clientWidth);
        var neededH = scaleEl.scrollHeight;
        var neededW = scaleEl.scrollWidth;
        var scaleH = neededH > 0 ? availableH / neededH : 1;
        var scaleW = neededW > 0 ? availableW / neededW : 1;
        var scale = Math.min(1, scaleH, scaleW);
        scale = Math.max(0.52, Math.min(1, scale));
        scaleEl.style.transform = base + " scale(" + scale + ")";
      }

      function fitAll() {
        slides.forEach(fitSlide);
      }

      function setFinalCount(el) {
        var target = parseInt(el.getAttribute("data-count"), 10);
        el.textContent = el.getAttribute("data-format") === "comma"
          ? target.toLocaleString("en-US")
          : String(target);
        el.setAttribute("data-counted", "1");
      }

      function animateCount(el) {
        if (el.getAttribute("data-counted") === "1") return;
        if (reduced) { setFinalCount(el); return; }
        el.setAttribute("data-counted", "1");
        var target = parseInt(el.getAttribute("data-count"), 10);
        var duration = 1200;
        var start = null;
        function tick(ts) {
          if (!start) start = ts;
          var t = Math.min(1, (ts - start) / duration);
          var eased = 1 - Math.pow(1 - t, 3);
          var current = Math.round(target * eased);
          el.textContent = el.getAttribute("data-format") === "comma"
            ? current.toLocaleString("en-US")
            : String(current);
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      function resetSlideMotion(slide) {
        Array.prototype.forEach.call(slide.querySelectorAll(".reveal"), function (el) {
          el.classList.remove("is-visible");
          el.style.removeProperty("--d");
        });
        Array.prototype.forEach.call(slide.querySelectorAll("[data-stack]"), function (el) {
          el.classList.remove("is-on");
        });
        Array.prototype.forEach.call(slide.querySelectorAll("[data-layer]"), function (el) {
          el.classList.remove("is-on");
        });
        Array.prototype.forEach.call(slide.querySelectorAll("[data-path]"), function (el) {
          el.classList.remove("is-drawn");
        });
        Array.prototype.forEach.call(slide.querySelectorAll("[data-collage]"), function (el) {
          el.classList.remove("is-on");
        });
        if (timeline && slide.contains(timeline)) timeline.classList.remove("is-visible");
      }

      function activateSlide(slide) {
        Array.prototype.forEach.call(slide.querySelectorAll(".reveal"), function (el, i) {
          el.style.setProperty("--d", (reduced ? 0 : i * 70) + "ms");
          el.classList.add("is-visible");
        });

        Array.prototype.forEach.call(slide.querySelectorAll("[data-stack]"), function (el, i) {
          if (reduced) {
            el.classList.add("is-on");
            return;
          }
          setTimeout(function () { el.classList.add("is-on"); }, 120 + i * 70);
        });

        Array.prototype.forEach.call(slide.querySelectorAll("[data-layer]"), function (el, i) {
          if (reduced) {
            el.classList.add("is-on");
            return;
          }
          setTimeout(function () { el.classList.add("is-on"); }, 100 + i * 90);
        });

        Array.prototype.forEach.call(slide.querySelectorAll("[data-path]"), function (el) {
          if (reduced) el.classList.add("is-drawn");
          else setTimeout(function () { el.classList.add("is-drawn"); }, 220);
        });

        Array.prototype.forEach.call(slide.querySelectorAll("[data-collage]"), function (el, i) {
          if (reduced) {
            el.classList.add("is-on");
            return;
          }
          setTimeout(function () { el.classList.add("is-on"); }, 80 + i * 90);
        });

        Array.prototype.forEach.call(slide.querySelectorAll("[data-count]"), function (el) {
          if (reduced) setFinalCount(el);
          else animateCount(el);
        });

        if (slide.id === "speed" && timeline) {
          if (reduced) timeline.classList.add("is-visible");
          else setTimeout(function () { timeline.classList.add("is-visible"); }, 180);
        }

        if (slide.id === "hero" && !slide.classList.contains("hero-loaded")) {
          requestAnimationFrame(function () { slide.classList.add("hero-loaded"); });
        }

        requestAnimationFrame(function () { fitSlide(slide); });
        setTimeout(function () { fitSlide(slide); }, reduced ? 0 : 520);
      }

      function goTo(i, opts) {
        opts = opts || {};
        if (i < 0 || i >= total) return;
        index = i;
        track.style.transform = "translate3d(" + (-index * 100) + "%, 0, 0)";

        slides.forEach(function (slide, si) {
          var active = si === index;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", active ? "false" : "true");
          if (active) activateSlide(slide);
          else resetSlideMotion(slide);
        });

        dots.forEach(function (d, di) {
          d.classList.toggle("active", di === index);
          d.classList.toggle("seen", di < index);
        });

        currEl.textContent = String(index + 1);
        prevBtn.disabled = index === 0;
        nextBtn.disabled = index === total - 1;

        var chapterEl = document.getElementById("chromeChapter");
        if (chapterEl) chapterEl.textContent = slides[index].getAttribute("data-chapter") || "";

        if (!opts.skipHash) {
          var id = slides[index].id;
          if (history.replaceState) history.replaceState(null, "", "#" + id);
        }
      }

      function next() { goTo(index + 1); }
      function prev() { goTo(index - 1); }

      prevBtn.addEventListener("click", prev);
      nextBtn.addEventListener("click", next);

      document.addEventListener("keydown", function (e) {
        if (e.target && /INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
        if (e.key === "ArrowRight" || e.key === "PageDown" || e.key === " ") {
          e.preventDefault();
          next();
        } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
          e.preventDefault();
          prev();
        } else if (e.key === "Home") {
          e.preventDefault();
          goTo(0);
        } else if (e.key === "End") {
          e.preventDefault();
          goTo(total - 1);
        }
      });

      document.querySelectorAll("[data-slide], a[href^='#']").forEach(function (el) {
        el.addEventListener("click", function (e) {
          var id = el.getAttribute("data-slide") || (el.getAttribute("href") || "").replace("#", "");
          if (!id || indexById[id] == null) return;
          e.preventDefault();
          goTo(indexById[id]);
        });
      });

      var wheelLock = false;
      document.querySelector(".deck").addEventListener("wheel", function (e) {
        e.preventDefault();
        if (wheelLock) return;
        if (Math.abs(e.deltaY) < 12 && Math.abs(e.deltaX) < 12) return;
        wheelLock = true;
        var forward = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX > 0 : e.deltaY > 0;
        if (forward) next(); else prev();
        setTimeout(function () { wheelLock = false; }, 500);
      }, { passive: false });

      var touchX = null;
      document.querySelector(".deck").addEventListener("touchstart", function (e) {
        touchX = e.changedTouches[0].clientX;
      }, { passive: true });
      document.querySelector(".deck").addEventListener("touchend", function (e) {
        if (touchX == null) return;
        var dx = e.changedTouches[0].clientX - touchX;
        touchX = null;
        if (Math.abs(dx) < 50) return;
        if (dx < 0) next(); else prev();
      }, { passive: true });

      window.addEventListener("resize", function () {
        fitAll();
      });

      Array.prototype.forEach.call(document.querySelectorAll(".collage img"), function (img) {
        if (img.complete) return;
        img.addEventListener("load", function () {
          fitSlide(document.getElementById("in-market"));
        }, { once: true });
      });

      var startId = (location.hash || "").replace("#", "");
      var start = indexById[startId] != null ? indexById[startId] : 0;
      goTo(start, { skipHash: !startId });
      fitAll();
    })();
  </script>
</body>
</html>
